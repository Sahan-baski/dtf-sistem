# Bu dosyayı kopyalayıp ".env" adıyla kaydet ve gerçek değerleri gir.
# ".env" asla Git'e gönderilmez (.gitignore'da) - sadece kendi bilgisayarında
# ve Render'ın "Environment" ayarlarında durur.

# --- Mevcut ayarlar (zaten kullanılıyordu) ---
MONGODB_URI=mongodb://localhost:27017/dtf
JWT_SECRET=degistir-bunu-guclu-bir-sifreyle
PORT=3001

# --- Ortak Stok Senkron (WooCommerce) için yeni ayarlar ---
# Sitenin adresi (sonunda / OLMADAN)
WC_SITE_URL=https://mirasgiyim.com

# WooCommerce → Ayarlar → Gelişmiş → REST API'den oluşturulan anahtarlar
# (Yetki: "Okuma/Yazma" olmalı)
WC_CONSUMER_KEY=ck_...
WC_CONSUMER_SECRET=cs_...

# WooCommerce → Ayarlar → Gelişmiş → Webhooklar'da oluşturacağın webhook'un
# "Gizli Anahtar" alanına AYNI değeri yapıştır - sipariş bildirimlerinin
# gerçekten WooCommerce'den geldiğini doğrulamak için kullanılır. Rastgele,
# uzun bir metin olabilir (ör. bir şifre üreticiden).
WC_WEBHOOK_SECRET=

# --- Ürünler paneli: görsel yükleme için WordPress'in KENDİ hesabı ---
# Bunlar WooCommerce anahtarlarından TAMAMEN FARKLI - WordPress'te
# Kullanıcılar → Profilim → "Uygulama Şifreleri" bölümünden oluşturulur.
# Sadece ürün eklerken görsel yüklemek için kullanılır.
WP_KULLANICI_ADI=
WP_UYGULAMA_SIFRESI=
